@startuml
autonumber
'hide footbox

participant ":VaccinationCenterMapper" as VCMapper
participant "lVaccinationCenters: List<VaccinationCenter>" as ListVCenters
participant "lVaccinationCentersDTO : List<vaccinationCentersDTO>" as VCListDTO
participant "vaccinationCenter : VaccinationCenter" as Vcenter
participant "objectDTO : VaccinationCenterDTO" as objDTO

activate VCMapper
[o->VCMapper : toDTO(lVaccinationCenters)
VCMapper-->VCListDTO** : create()

loop for each VaccinationCenter in lVaccinationCenters
VCMapper -> ListVCenters : vaccinationCenter = getVaccinationCenter(i)
activate ListVCenters
deactivate ListVCenters

VCMapper -> Vcenter : name = getName()
activate Vcenter
deactivate Vcenter

VCMapper -> Vcenter : address = getAddress()
activate Vcenter
deactivate Vcenter

note left : continues until getting all vaccinationCenter attributes

VCMapper --> objDTO** : create(name, address, ...)

VCMapper -> VCListDTO : add(objectDTO)
activate VCListDTO
deactivate VCListDTO

end

<-- VCMapper : lVaccinationCentersDTO
deactivate VCMapper


@enduml